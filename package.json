{
	"name": "generator-nsis",
	"version": "0.14.0",
	"description": "Yeoman generator for NSIS scripts",
	"author": "Jan T. Sott",
	"license": "MIT",
	"keywords": [
		"yeoman-generator",
		"nsis",
		"nullsoft",
		"installer",
		"setup"
	],
	"type": "module",
	"exports": "./generators/app/index.js",
	"files": [
		"generators",
		"lib",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"lint:e18e": "e18e-cli analyze",
		"lint:code": "biome check",
		"lint": "concurrently --prefix '{name}' -c 'green,blue' 'npm:lint:*'",
		"publish:npm": "np",
		"test": "uvu --ignore tests/__helper.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/generator-nsis.git"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@idleberg/yeoman-generator": "^0.3.0",
		"@nsis/language-data": "^0.11.0",
		"@sindresorhus/slugify": "^3.0.0",
		"kleur": "^4.1.5",
		"makensis": "3.0.5",
		"semver": "^7.8.0",
		"spdx-license-list": "^6.11.0",
		"terminal-link": "^5.0.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@idleberg/configs": "^0.4.2",
		"@lukeed/uuid": "^2.0.1",
		"@types/node": "^24.12.0",
		"concurrently": "^9.2.1",
		"np": "^11.2.1",
		"tsm": "^2.3.0",
		"typescript": "^6.0.3",
		"uvu": "^0.5.6",
		"yeoman-assert": "^3.1.1",
		"yeoman-environment": "^6.1.0",
		"yeoman-test": "^11.5.2"
	},
	"packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
